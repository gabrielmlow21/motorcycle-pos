# System-level tools. Install with: brew bundle install
#
# Project dependencies (Laravel packages, React, Vite) are NOT listed here —
# they come from composer.lock and package-lock.json via `make setup`.

brew "php"       # runs the Laravel API locally
brew "composer"  # PHP package manager
brew "gh"        # GitHub CLI, used for repo and Actions secrets

cask "docker-desktop"  # provides the local MySQL container (see compose.yaml)
